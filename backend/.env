DATABASE_URL=postgresql://postgres:password@localhost:5432/esportorium

SUPABASE_URL=
SUPABASE_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=esportorium-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Cloudflare Turnstile ───────────────────────────────────────────────────────
# Get your keys at: https://dash.cloudflare.com/?to=/:account/turnstile
# For local dev the test secret below always passes — replace before going live.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── Discord Webhook ────────────────────────────────────────────────────────────
# Create a webhook in a private Discord channel and paste the URL here.
# Leave blank to disable notifications.
DISCORD_WEBHOOK_URL=
