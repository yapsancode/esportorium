# Production environment — values are baked in at build time by Vite.
# Set these in the Cloudflare Pages dashboard under Settings > Environment variables.
# The values here are used when building locally with `vite build`.

VITE_API_BASE_URL=https://your-backend-url.railway.app

# Replace with your real Cloudflare Turnstile site key before going live.
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-real-turnstile-site-key
