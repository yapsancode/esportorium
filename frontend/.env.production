# Production environment — values are baked in at build time by Next.js.
# Set these in the Cloudflare Pages / Railway / Render dashboard under Environment variables.

NEXT_PUBLIC_API_BASE_URL=https://your-backend-url.railway.app

# Replace with your real Cloudflare Turnstile site key before going live.
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-real-turnstile-site-key
