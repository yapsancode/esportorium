# Production environment — Next.js bakes NEXT_PUBLIC_* vars into the bundle at build time.
#
# ⚠️  DO NOT leave these as placeholders.
#     Set real values in the Vercel dashboard (Settings → Environment Variables).
#     Vercel dashboard values override this file during deployment builds.
#
# If building locally for production:
#   Replace these values with your actual URLs before running `npm run build`.

NEXT_PUBLIC_API_BASE_URL=https://your-cloud-run-url.a.run.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-real-turnstile-site-key
